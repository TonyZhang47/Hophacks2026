# Copy to .env.local. The app runs in DEMO mode (seed data, template rewrites,
# browser speech) when keys are missing. Fill in to enable live services.
XAI_API_KEY=
ELEVENLABS_API_KEY=            # secondary voice only; app must run without it
ELEVENLABS_VOICE_ID=
OPENFDA_API_KEY=               # optional, higher rate limit
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_B64=     # optional key-pair auth (base64 PEM)
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
CORTEX_SEARCH_SERVICE=LABEL_SEARCH
