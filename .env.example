# Copy to .env.local. The app runs in DEMO mode (seed data, template rewrites,
# browser speech) when keys are missing. Fill in to enable live services.
XAI_API_KEY=                   # starts with "xai-" (console.x.ai); a bare UUID is a key ID, not the key
XAI_CHAT_MODEL=grok-4-fast     # optional override
XAI_VISION_MODEL=grok-4-fast   # optional override for bottle scanning
ELEVENLABS_API_KEY=            # starts with "sk_"; secondary voice only; app must run without it
ELEVENLABS_VOICE_ID=
OPENFDA_API_KEY=               # optional, higher rate limit
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_B64=     # optional key-pair auth (base64 PEM)
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
CORTEX_SEARCH_SERVICE=LABEL_SEARCH
